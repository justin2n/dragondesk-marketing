# ── DragonDesk: Optimize ──────────────────────────────────────────────────────
# Base URL of the Optimize backend. The Optimize page's "Get Started" button
# POSTs to `${VITE_OPTIMIZE_API_URL}/api/billing/public/checkout` to open Stripe
# Checkout, so this must point at a host that actually resolves, over https.
#
# Two things have to line up or the button fails with "Failed to fetch":
#   1. This host resolves (custom domain, or the *.up.railway.app URL).
#   2. This site's origin is listed in the Optimize app's ALLOWED_ORIGINS env
#      var — otherwise its CORS check rejects the request.
#
# Vite inlines VITE_* vars at build time, so changing this needs a rebuild.
VITE_OPTIMIZE_API_URL=https://optimize.dragondeskapp.com

# ── DragonDesk: CRM ───────────────────────────────────────────────────────────
# Lead-capture forms on the main site POST here. Separate app from Optimize.
VITE_DRAGONDESK_API_URL=https://dragondesk-owner-production.up.railway.app
